# Copy this file to .env on the VPS and fill in real values.
# .env is gitignored — never commit real secrets.

NODE_ENV=production

# Postgres (self-hosted via docker-compose's postgres service).
# DATABASE_URL is built automatically in docker-compose.yml from these three —
# do not set DATABASE_URL directly here.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=sabayrent

# Domain Caddy will request a TLS cert for (A record must already point at this VPS).
DOMAIN=

UPLOAD_TMP_DIR=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_TOKEN=
R2_S3_API=
R2_PUB_URL=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

ADMIN_TELEGRAM_CHAT_ID=
ADMIN_ALERT_EMAIL=

GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=

# Only needed once, to run `docker compose exec app npx prisma db seed`.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
LANDLORD_SEED_EMAIL=
LANDLORD_SEED_PASSWORD=
