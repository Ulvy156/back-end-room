{
  "info": {
    "_postman_id": "a1b2c3d4-auth-collection-rent-room",
    "name": "Auth",
    "description": "Authentication endpoints for Rent Room.\n\nBase URL: {{baseUrl}}\n\nToken behavior:\n- Access token: 15 min — send as Authorization: Bearer <token>\n- Refresh token: 7 days — HttpOnly cookie set automatically by the server\n\nPassword requirements: min 8 chars, 1 uppercase, 1 lowercase, 1 number, 1 symbol.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "Paste the accessToken from login or verify-account response here"
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"user@example.com\",\n  \"password\": \"YourPassword123!\",\n  \"role\": \"USER\",\n  \"phone\": \"+85512345678\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "description": "Creates a new user account. Sends a 6-digit OTP to the user's email for verification. No tokens are issued yet — call verify-account next.\n\nrole: 'USER' (default) or 'LANDLORD'. 'ADMIN' is not allowed here.\n\nphone: optional. If provided, stored in the Phone table (type PHONE). The user can then log in using either their email or this phone number."
      },
      "response": [
        {
          "name": "201 Created",
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"user@example.com\",\n  \"password\": \"YourPassword123!\",\n  \"role\": \"USER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Account created. Please check your email for the OTP to verify your account.\",\n  \"user_id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\"\n}"
        }
      ]
    },
    {
      "name": "Verify Account",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"384920\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/verify-account",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "verify-account"]
        },
        "description": "Verifies the account using the 6-digit OTP sent to the user's email during registration. On success, issues both tokens and the user is logged in immediately.\n\nRate limit: 5 attempts per 15 minutes per IP.\nOTP expires in 10 minutes."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"384920\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/verify-account", "host": ["{{baseUrl}}"], "path": ["auth", "verify-account"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user_id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\"\n}"
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"user@example.com\",\n  \"password\": \"YourPassword123!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Authenticates a user with password. The refresh token is set as an HttpOnly cookie automatically.\n\nidentifier: email address (contains @) or phone number (e.g. +85512345678). The server detects which one was sent automatically.\n\nRate limit: 5 requests per 15 minutes per IP.\n\nErrors:\n- 401: Wrong identifier or password\n- 403: Account not verified (redirect to OTP screen)\n- 403: Account is locked\n\nNote: 401 vs 403 is intentional — use the status code to distinguish wrong credentials from blocked accounts."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"user@example.com\",\n  \"password\": \"YourPassword123!\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user_id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\"\n}"
        }
      ]
    },
    {
      "name": "Login with Telegram",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 123456789,\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"username\": \"johndoe\",\n  \"photo_url\": \"https://t.me/i/userpic/320/example.jpg\",\n  \"auth_date\": 1747123456,\n  \"hash\": \"abc123def456...\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/telegram-login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "telegram-login"]
        },
        "description": "Sign up or log in using the Telegram Login Widget payload. The server verifies the HMAC-SHA256 hash before issuing tokens.\n\nRate limit: 5 requests per 15 minutes per IP.\n\nFirst time (sign up): a new account is created automatically with role USER. is_new_user: true is returned — show the role picker and call PATCH /auth/select-role, then POST /auth/refresh-token to refresh the JWT.\nReturning user (login): account is looked up by Telegram ID, tokens are issued normally. is_new_user: false.\n\nauth_date must be within 24 hours.\n\nSend the object from Telegram's onTelegramAuth(user) callback directly to this endpoint."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": 123456789,\n  \"first_name\": \"John\",\n  \"auth_date\": 1747123456,\n  \"hash\": \"abc123...\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/telegram-login", "host": ["{{baseUrl}}"], "path": ["auth", "telegram-login"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user_id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"is_new_user\": true\n}"
        }
      ]
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/refresh-token",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh-token"]
        },
        "description": "Issues a new access token using the refresh_token HttpOnly cookie. Also rotates the refresh token — the old cookie is replaced with a new one.\n\nThe browser sends the cookie automatically. No body needed.\n\nErrors:\n- 401: Cookie missing, token expired, or already used (rotation violation)."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth", "refresh-token"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        },
        "description": "Invalidates the current refresh token and clears the cookie. The access token expires on its own after 15 minutes.\n\nAlways returns 204 even if no cookie is present."
      },
      "response": [
        {
          "name": "204 No Content",
          "originalRequest": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          },
          "status": "No Content",
          "code": 204,
          "_postman_previewlanguage": "text",
          "header": [],
          "body": ""
        }
      ]
    },
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/profile",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "profile"]
        },
        "description": "Returns the currently authenticated user's data. Requires a valid access token.\n\nErrors:\n- 401: Missing or expired access token."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"name\": \"John Doe\",\n  \"email\": \"user@example.com\",\n  \"imgUrl\": \"profile/abc123.webp\",\n  \"isLocked\": false,\n  \"role\": \"USER\",\n  \"createdAt\": \"2025-01-01T00:00:00.000Z\",\n  \"updatedAt\": \"2025-01-01T00:00:00.000Z\"\n}"
        }
      ]
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"channel\": \"email\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "forgot-password"]
        },
        "description": "Sends a 6-digit OTP to the user via the chosen channel. OTP expires in 10 minutes.\n\nRate limit: 3 requests per 15 minutes per IP.\n\nchannel: 'email' — sends to Gmail address. 'telegram' — sends as a DM from the bot (user must have a linked Telegram account).\n\nAlways returns success regardless of whether the email exists (prevents account enumeration)."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"channel\": \"email\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"If an account with that email exists, an OTP has been sent\"\n}"
        }
      ]
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"482931\",\n  \"newPassword\": \"NewPassword123!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "reset-password"]
        },
        "description": "Resets the user's password using the OTP from forgot-password. All active sessions are invalidated on success (all refresh tokens are revoked).\n\nRate limit: 5 attempts per 15 minutes per IP.\n\nnewPassword requirements: min 8 chars, 1 uppercase, 1 lowercase, 1 number, 1 symbol."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"482931\",\n  \"newPassword\": \"NewPassword123!\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"] }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Password reset successfully. Please log in again.\"\n}"
        }
      ]
    },
    {
      "name": "Select Role",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"LANDLORD\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/select-role",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "select-role"]
        },
        "description": "Sets the role for the authenticated user. Only valid for new accounts created via Google or Telegram sign-up, but can technically be called by any authenticated user to switch between USER and LANDLORD.\n\nCall this immediately after receiving is_new_user: true, then call POST /auth/refresh-token to get a new JWT that reflects the updated role.\n\nRate limit: 5 requests per 15 minutes per IP.\n\nrole: 'USER' or 'LANDLORD' only. 'ADMIN' is rejected.\n\nReturns 204 No Content on success."
      },
      "response": [
        {
          "name": "204 No Content",
          "originalRequest": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"LANDLORD\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/select-role", "host": ["{{baseUrl}}"], "path": ["auth", "select-role"] }
          },
          "status": "No Content",
          "code": 204,
          "_postman_previewlanguage": "text",
          "header": [],
          "body": ""
        }
      ]
    },
    {
      "name": "Login with Google",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/google",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "google"]
        },
        "description": "Opens this URL in the browser — redirects the user to Google's consent screen.\n\nDo not call this from Postman directly. Open it in a browser tab.\n\nAfter the user approves, Google redirects to /auth/google/callback which then redirects to:\n  FRONT_END_URL/auth/callback?token=<accessToken>&is_new_user=true|false\n\nThe refresh token is set as an HttpOnly cookie automatically.\n\nFirst time (sign up): account is created with role USER and isVerified true. is_new_user=true in the redirect — show the role picker and call PATCH /auth/select-role, then POST /auth/refresh-token to refresh the JWT.\nReturning user (login): is_new_user=false.\nExisting email+password account: linked silently, is_new_user=false."
      },
      "response": []
    }
  ]
}
