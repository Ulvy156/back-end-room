{
  "info": {
    "_postman_id": "b2c3d4e5-property-collection-rent-room",
    "name": "Property",
    "description": "Property listing endpoints for Rent Room.\n\nBase URL: {{baseUrl}}\n\nPublic endpoints (no auth): home-page, browse-properties, property-details, related-properties, increment-view.\n\nAll other endpoints require: Authorization: Bearer {{accessToken}}\n\nCreate/update/delete require ownership (LANDLORD role) or ADMIN.\nset-feature requires ADMIN.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "propertyId", "value": "", "type": "string" },
    { "key": "imageId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Get Homepage Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/property/home-page", "host": ["{{baseUrl}}"], "path": ["property", "home-page"] },
            "description": "Returns featured listings (up to 3), latest listings (up to 4), and popular locations (top 10). All results are cached."
          },
          "response": []
        },
        {
          "name": "Browse Properties",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"limit\": 20,\n  \"minPrice\": 0,\n  \"maxPrice\": 500,\n  \"location\": 0,\n  \"locationType\": \"district\",\n  \"roomType\": 0,\n  \"bedroom\": 0,\n  \"bathroom\": 0,\n  \"amenities\": [],\n  \"houseRules\": [],\n  \"orderType\": 0,\n  \"lat\": null,\n  \"lng\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/property/browse-properties", "host": ["{{baseUrl}}"], "path": ["property", "browse-properties"] },
            "description": "Filter and paginate published properties.\n\norderType: 0=newest, 1=price asc, 2=price desc, 3=most popular, 4=nearest (requires lat/lng)\nlocationType: 'district' or 'province'\namenities/houseRules: AND logic — property must have ALL selected IDs\ndistanceKm is included on each item only when lat/lng are provided.\n\nReturns: { items[], meta: { page, limit, total, totalPages } }"
          },
          "response": []
        },
        {
          "name": "Get Property Detail",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{propertyId}}\",\n  \"lat\": null,\n  \"lng\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/property/property-details", "host": ["{{baseUrl}}"], "path": ["property", "property-details"] },
            "description": "Returns full property detail including amenities, rules (all rules with is_allow flag), parking, landlord info, and distance if lat/lng provided. Only published properties are returned."
          },
          "response": []
        },
        {
          "name": "Get Related Properties",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/property/related-properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["property", "related-properties", "{{propertyId}}"] },
            "description": "Returns up to 6 published properties near the given property with similar price range (±20%), bedroom count (±2), and property type. Sorted by distance. Returns [] if none found."
          },
          "response": []
        },
        {
          "name": "Increment View Count",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/property/increment-view/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["property", "increment-view", "{{propertyId}}"] },
            "description": "Fire-and-forget — enqueues a background job to increment totalViews. Returns 204 immediately.\n\nRate limit: 10 per minute."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Landlord",
      "item": [
        {
          "name": "Create Property",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files", "type": "file", "description": "At least one image required. Multiple allowed." },
                { "key": "title", "value": "Modern Room near Market", "type": "text" },
                { "key": "address", "value": "Street 123, Phnom Penh", "type": "text" },
                { "key": "description", "value": "Bright room with natural light.", "type": "text" },
                { "key": "monthly_price", "value": "250", "type": "text" },
                { "key": "deposit", "value": "250", "type": "text" },
                { "key": "bedroom", "value": "1", "type": "text" },
                { "key": "bathroom", "value": "1", "type": "text" },
                { "key": "floor", "value": "2", "type": "text" },
                { "key": "totalFloors", "value": "4", "type": "text" },
                { "key": "sizeSqm", "value": "25", "type": "text" },
                { "key": "furnished", "value": "true", "type": "text" },
                { "key": "districtId", "value": "1201", "type": "text" },
                { "key": "propertyTypeId", "value": "1", "type": "text" },
                { "key": "amenityKeys", "value": "[1, 2]", "type": "text", "description": "JSON array of amenity IDs" },
                { "key": "lat", "value": "11.5564", "type": "text" },
                { "key": "lng", "value": "104.9282", "type": "text" },
                { "key": "folderType", "value": "properties", "type": "text" },
                { "key": "userId", "value": "", "type": "text", "description": "Landlord user ID" },
                { "key": "openTime", "value": "06:00", "type": "text", "disabled": true, "description": "Optional. Property open time in HH:mm format." },
                { "key": "closeTime", "value": "22:00", "type": "text", "disabled": true, "description": "Optional. Property close time in HH:mm format." }
              ]
            },
            "url": { "raw": "{{baseUrl}}/property", "host": ["{{baseUrl}}"], "path": ["property"] },
            "description": "Creates a new property listing as a draft (isPublished: false by default). Uploads images to R2, optimized to WebP.\n\nRole: LANDLORD or ADMIN.\nLimit: 3 properties per 30 days per landlord.\nRate limit: 2 per 10 minutes.\n\nErrors:\n- 400: No images provided\n- 400: Monthly limit reached\n- 403: Not LANDLORD or ADMIN"
          },
          "response": []
        },
        {
          "name": "Get My Properties",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/property/my-properties", "host": ["{{baseUrl}}"], "path": ["property", "my-properties"] },
            "description": "Returns all properties belonging to the authenticated landlord, ordered by newest first. Includes isPublished, isAvailable, isFeatured status for management dashboard."
          },
          "response": []
        },
        {
          "name": "Update Property",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"monthly_price\": 280,\n  \"amenityKeys\": [1, 3],\n  \"openTime\": \"06:00\",\n  \"closeTime\": \"22:00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/property/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["property", "{{propertyId}}"] },
            "description": "Updates property fields. Amenities and parkings are REPLACED (not merged) if provided.\n\nOwnership required — 403 if not owner or ADMIN."
          },
          "response": []
        },
        {
          "name": "Toggle Publish",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/property/toggle-publish/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["property", "toggle-publish", "{{propertyId}}"] },
            "description": "Flips isPublished on the property. Unpublished properties are hidden from browse, homepage, and detail endpoints.\n\nOwnership required."
          },
          "response": []
        },
        {
          "name": "Toggle Availability",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/property/toggle-availability/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["property", "toggle-availability", "{{propertyId}}"] },
            "description": "Flips isAvailable on the property. Use when a property is rented out — it stays visible but signals unavailability to tenants.\n\nOwnership required."
          },
          "response": []
        },
        {
          "name": "Delete Property",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/property/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["property", "{{propertyId}}"] },
            "description": "Deletes the property and removes all associated images from R2.\n\nOwnership required. Rate limit: 10 per minute."
          },
          "response": []
        },
        {
          "name": "Duplicate Property",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/property/{{propertyId}}/duplicate", "host": ["{{baseUrl}}"], "path": ["property", "{{propertyId}}", "duplicate"] },
            "description": "Creates an unpublished copy of the property with the same settings (title, description, price, location, amenities, house rules, parking). Does NOT copy images — landlord must upload new ones.\n\nTitle is appended with '(copy)'. The copy is set to isPublished: false.\n\nOwnership required. Subject to the 3-property-per-month limit. Rate limit: 2 per 10 minutes."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                "url": { "raw": "{{baseUrl}}/property/{{propertyId}}/duplicate", "host": ["{{baseUrl}}"], "path": ["property", "{{propertyId}}", "duplicate"] }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"new-uuid\",\n  \"title\": \"Cozy Room in BKK1 (copy)\",\n  \"isPublished\": false,\n  \"monthly_price\": 250,\n  \"createdAt\": \"2026-06-22T12:00:00.000Z\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get All Properties",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/property?isPublished=true&search=modern&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["property"],
              "query": [
                { "key": "isPublished", "value": "true", "description": "Filter by publish status: true | false. Omit for all." },
                { "key": "isFeatured", "value": "true", "description": "Filter featured only: true | false. Omit for all." },
                { "key": "isAvailable", "value": "true", "description": "Filter by availability: true | false. Omit for all." },
                { "key": "search", "value": "modern", "description": "Search by property title (case-insensitive)." },
                { "key": "page", "value": "1", "description": "Page number. Default: 1." },
                { "key": "limit", "value": "20", "description": "Results per page. Default: 20. Max: 100." }
              ]
            },
            "description": "Admin view of all properties with filtering, search, and pagination. Includes landlord info (name, email) in each result.\n\nRole: ADMIN only.\n\nExamples:\n- All published: ?isPublished=true\n- Drafts/unpublished: ?isPublished=false\n- Featured only: ?isFeatured=true  ← powers the Featured nav section\n- Rented out: ?isAvailable=false\n- Search: ?search=modern+room\n- Combined: ?isPublished=true&search=room&page=2"
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                "url": { "raw": "{{baseUrl}}/property?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["property"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"items\": [\n    {\n      \"id\": \"uuid\",\n      \"title\": \"Modern Room near Market\",\n      \"monthly_price\": 250,\n      \"isPublished\": true,\n      \"isAvailable\": true,\n      \"isFeatured\": false,\n      \"totalViews\": 120,\n      \"createdAt\": \"2025-01-01T00:00:00.000Z\",\n      \"user\": { \"id\": \"uuid\", \"name\": \"Sok Dara\", \"email\": \"dara@example.com\" },\n      \"images\": [{ \"imageKey\": \"properties/abc.webp\" }],\n      \"district\": { \"nameEn\": \"Chamkarmon\", \"nameKh\": \"ចំការមន\", \"province\": { \"nameEn\": \"Phnom Penh\", \"nameKh\": \"ភ្នំពេញ\" } },\n      \"propertyType\": { \"nameEn\": \"Room\", \"nameKh\": \"បន្ទប់\", \"icon\": \"room\" }\n    }\n  ],\n  \"meta\": {\n    \"page\": 1,\n    \"limit\": 20,\n    \"total\": 48,\n    \"totalPages\": 3\n  }\n}"
            }
          ]
        },
        {
          "name": "Set Featured",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/property/set-feature/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["property", "set-feature", "{{propertyId}}"] },
            "description": "Toggles isFeatured on the property. Maximum 3 featured properties at a time.\n\nRole: ADMIN only."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Property Images",
      "item": [
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "description": "Single image file (JPEG, PNG, WEBP). Max 1MB." }
              ]
            },
            "url": { "raw": "{{baseUrl}}/property-image/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["property-image", "{{propertyId}}"] },
            "description": "Uploads a new image to an existing property. Image is resized and converted to WebP before upload.\n\nOwnership required. Rate limit: 10 per minute.\n\nErrors:\n- 400: Invalid file type or size > 1MB\n- 403: Not property owner or ADMIN\n- 404: Property not found"
          },
          "response": []
        },
        {
          "name": "Set Cover Image",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/property-image/{{imageId}}/set-cover", "host": ["{{baseUrl}}"], "path": ["property-image", "{{imageId}}", "set-cover"] },
            "description": "Sets this image as the cover photo. Atomically unsets isCover on all other images for the same property.\n\nOwnership required. Returns 204."
          },
          "response": []
        },
        {
          "name": "Delete Image",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/property-image/{{imageId}}", "host": ["{{baseUrl}}"], "path": ["property-image", "{{imageId}}"] },
            "description": "Deletes the image from R2 and removes the DB record.\n\nOwnership required. Returns 204."
          },
          "response": []
        }
      ]
    }
  ]
}
