{
  "info": {
    "_postman_id": "c3d4e5f6-user-collection-rent-room",
    "name": "User",
    "description": "User management and self-service endpoints for Rent Room.\n\nBase URL: {{baseUrl}}\n\nAdmin endpoints require ADMIN role: Authorization: Bearer {{accessToken}}\nSelf-service endpoints require any valid JWT — user can only modify their own data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "John Doe", "type": "text" },
                { "key": "email", "value": "john@example.com", "type": "text" },
                { "key": "password", "value": "Password123!", "type": "text" },
                { "key": "role", "value": "USER", "type": "text", "description": "USER, LANDLORD, or ADMIN" },
                { "key": "profile", "type": "file", "description": "Optional profile image" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/user", "host": ["{{baseUrl}}"], "path": ["user"] },
            "description": "Creates a user directly — bypasses the registration + OTP email verification flow. Account is created as verified.\n\nRole: ADMIN only."
          },
          "response": []
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/user", "host": ["{{baseUrl}}"], "path": ["user"] },
            "description": "Returns all users. Password is never included in the response.\n\nRole: ADMIN only."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/user", "host": ["{{baseUrl}}"], "path": ["user"] } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  {\n    \"id\": \"uuid\",\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"imgUrl\": null,\n    \"role\": \"USER\",\n    \"isVerified\": true,\n    \"isLocked\": false,\n    \"createdAt\": \"2025-01-01T00:00:00.000Z\",\n    \"updatedAt\": \"2025-01-01T00:00:00.000Z\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/user/{{userId}}", "host": ["{{baseUrl}}"], "path": ["user", "{{userId}}"] },
            "description": "Role: ADMIN only."
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Name\",\n  \"role\": \"LANDLORD\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/user/{{userId}}", "host": ["{{baseUrl}}"], "path": ["user", "{{userId}}"] },
            "description": "Admin can update any field on any user (name, email, role, etc.).\n\nRole: ADMIN only."
          },
          "response": []
        },
        {
          "name": "Lock User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/user/lock-user/{{userId}}", "host": ["{{baseUrl}}"], "path": ["user", "lock-user", "{{userId}}"] },
            "description": "Sets isLocked = true. The user cannot log in while locked.\n\nRole: ADMIN only."
          },
          "response": []
        },
        {
          "name": "Unlock User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/user/unlock-user/{{userId}}", "host": ["{{baseUrl}}"], "path": ["user", "unlock-user", "{{userId}}"] },
            "description": "Sets isLocked = false.\n\nRole: ADMIN only."
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/user/{{userId}}", "host": ["{{baseUrl}}"], "path": ["user", "{{userId}}"] },
            "description": "Permanently deletes the user and all related data (cascade).\n\nRole: ADMIN only."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Self-service",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/user/me", "host": ["{{baseUrl}}"], "path": ["user", "me"] },
            "description": "Returns own full profile including linked phone numbers (e.g. Telegram ID)."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/user/me", "host": ["{{baseUrl}}"], "path": ["user", "me"] } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"uuid\",\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"imgUrl\": \"profile/abc123.webp\",\n  \"role\": \"USER\",\n  \"isVerified\": true,\n  \"isLocked\": false,\n  \"createdAt\": \"2025-01-01T00:00:00.000Z\",\n  \"updatedAt\": \"2025-01-01T00:00:00.000Z\",\n  \"phones\": [\n    { \"phoneNumber\": \"123456789\", \"type\": \"TELEGRAM\" }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Update My Info",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Display Name\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/user/me", "host": ["{{baseUrl}}"], "path": ["user", "me"] },
            "description": "Updates own display name only. Email, password, and role changes have their own dedicated flows."
          },
          "response": []
        },
        {
          "name": "Update Profile Image",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "profile", "type": "file", "description": "New profile image. Max 1MB. Old image is deleted from R2 after success." }
              ]
            },
            "url": { "raw": "{{baseUrl}}/user/me/profile-image", "host": ["{{baseUrl}}"], "path": ["user", "me", "profile-image"] },
            "description": "Replaces own profile avatar. Uploads new image first, updates DB, then deletes old image from R2."
          },
          "response": []
        },
        {
          "name": "Delete Profile Image",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/user/me/profile-image", "host": ["{{baseUrl}}"], "path": ["user", "me", "profile-image"] },
            "description": "Removes own profile avatar from R2 and sets imgUrl to null."
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"OldPassword123!\",\n  \"newPassword\": \"NewPassword456!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"] },
            "description": "Changes own password. Requires current password to be correct. Session stays active — refresh tokens are NOT revoked.\n\nRate limit: 5 per 15 minutes.\n\nnewPassword requirements: min 8 chars, 1 uppercase, 1 lowercase, 1 number, 1 symbol.\n\nErrors:\n- 400: Current password is incorrect\n- 400: New password does not meet requirements"
          },
          "response": [
            {
              "name": "204 No Content",
              "originalRequest": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"OldPassword123!\",\n  \"newPassword\": \"NewPassword456!\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"] } },
              "status": "No Content",
              "code": 204,
              "_postman_previewlanguage": "text",
              "header": [],
              "body": ""
            }
          ]
        }
      ]
    }
  ]
}
