// ==============================
// GENERATOR & DATASOURCE
// ==============================
generator client {
  provider               = "prisma-client"
  output                 = "generated"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// ENUMS
// ==============================
enum UserRole {
  USER
  LANDLORD
  ADMIN
}

enum ParkingType {
  MOTO
  BICYCLE
  CAR
  TUK_TUK
}

enum PhoneNumberType {
  TELEGRAM
  PHONE
}

enum FeedbackType {
  BUG
  SUGGESTION
  OTHER
}

// ==============================
// USER
// ==============================
model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  imgUrl     String?  @map("img_url")
  isVerified       Boolean  @default(false) @map("is_verified")
  isLocked         Boolean  @default(false)
  hasVerifiedBadge Boolean  @default(false) @map("has_verified_badge")
  role             UserRole @default(USER)

  showPhone    Boolean @default(true) @map("show_phone")
  showTelegram Boolean @default(true) @map("show_telegram")
  showEmail    Boolean @default(true) @map("show_email")

  properties         Property[]
  favorites          Favorite[]
  phones             Phone[]
  propertyReport     PropertyReport[]
  feedbacks          Feedback[]
  refreshTokens      RefreshToken[]
  passwordResetToken PasswordResetToken?
  auditLogs          AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("users")
}

// ==============================
// REFRESH TOKENS
// ==============================
model RefreshToken {
  id     String @id @default(uuid())
  jti    String @unique
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Short-lived pointer to the jti this row was rotated FROM, so a refresh
  // call that loses a race against a concurrent rotation (same cookie, two
  // in-flight requests) can still be served instead of rejected as invalid.
  previousJti          String?   @map("previous_jti")
  previousJtiExpiresAt DateTime? @map("previous_jti_expires_at")

  @@index([userId])
  @@index([previousJti])
  @@map("refresh_tokens")
}

// ==============================
// PASSWORD RESET TOKENS
// ==============================
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  otp       String // SHA-256 hash of the 6-digit OTP
  channel   String // "telegram" | "email"
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ==============================
// PHONE
// ==============================
model Phone {
  id          Int             @id @default(autoincrement())
  phoneNumber String          @unique @map("phone_number")
  type        PhoneNumberType @default(PHONE)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("phones")
}

// ==============================
// LOCATION
// ==============================
model Province {
  id        Int    @id
  nameKh    String @map("name_kh")
  nameEn    String @map("name_en")
  latitude  Float
  longitude Float

  districts District[]

  @@map("provinces")
}

model District {
  id         Int    @id
  provinceId Int    @map("province_id")
  nameKh     String @map("name_kh")
  nameEn     String @map("name_en")

  province      Province       @relation(fields: [provinceId], references: [id])
  properties    Property[]
  locationViews LocationView[]

  @@unique([provinceId, nameEn])
  @@unique([provinceId, nameKh])
  @@index([provinceId])
  @@map("districts")
}

model LocationView {
  id         Int      @id @default(autoincrement())
  districtId Int      @unique @map("district_id")
  views      Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  district District @relation(fields: [districtId], references: [id])

  @@index([views])
  @@map("location_views")
}

// ==============================
// PROPERTY
// ==============================
model Property {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  districtId Int    @map("district_id")

  address         String
  lat             Float?
  lng             Float?
  nearby_location String? @default("")

  title       String
  description String?

  monthly_price Float
  deposit       Float?

  bedroom     Int @default(1)
  bathroom    Int @default(1)
  floor       Int @default(1) // current floor
  totalFloors Int @default(1) // building height

  isAvailable   Boolean  @default(true) @map("is_available")
  availableFrom DateTime @default(now()) @map("available_from")

  isFeatured Boolean   @default(false) @map("is_featured")
  featuredAt DateTime? @map("featured_at")

  totalViews Int @default(0) @map("total_views")

  propertyTypeId    Int     @map("property_type_id")
  sizeSqm           Int     @map("size_sqm")
  furnished         Boolean @default(true)
  isPublished       Boolean @default(true) @map("is_published")
  minimumStayLength Int     @default(1) @map("minimum_stay_length")

  openTime  String? @map("open_time")
  closeTime String? @map("close_time")

  user         User         @relation(fields: [userId], references: [id])
  district     District     @relation(fields: [districtId], references: [id])
  propertyType PropertyType @relation(fields: [propertyTypeId], references: [id])

  images            PropertyImage[]
  favorites         Favorite[]
  propertyAmenities PropertyAmenity[]
  propertyReport    PropertyReport[]
  propertyViews     PropertyView[]
  propertyRuleValue PropertyRuleValue[]
  parkings          Parking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([districtId, isAvailable])
  @@index([propertyTypeId])
  @@index([monthly_price])
  @@index([isPublished])
  @@index([districtId, propertyTypeId])
  @@index([isPublished, monthly_price])
  @@index([lat])
  @@index([lng])
  @@index([lat, lng])
  @@map("properties")
}

// ==============================
// PARKING
// ==============================
model Parking {
  id String @id @default(uuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type   ParkingType
  slots  Int         @default(0) // total slots
  isFree Boolean     @default(true)
  price  Float? // nullable if free
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@map("parkings")
}

// ==============================
// PROPERTY TYPE
// ==============================
model PropertyType {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  nameEn    String  @unique @map("name_en")
  nameKh    String  @unique @map("name_kh")
  icon      String
  slug      String  @unique
  isRemoved Boolean @default(false) @map("is_removed")

  properties Property[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@index([isRemoved])
  @@map("property_types")
}

// ==============================
// PROPERTY VIEWS
// ==============================
model PropertyView {
  id         Int      @id @default(autoincrement())
  propertyId String
  views      Int
  date       DateTime

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@index([date])
  @@map("property_views")
}

// ==============================
// PROPERTY RULES
// ==============================
model PropertyRules {
  id     Int                 @id @default(autoincrement())
  key    String
  nameEn String              @unique @map("name_en")
  nameKh String              @unique @map("name_kh")
  icon   String
  values PropertyRuleValue[]

  @@unique([key])
  @@index([key])
  @@map("property_rules")
}

// ==============================
// PROPERTY RULES VALUES
// ==============================
model PropertyRuleValue {
  id Int @id @default(autoincrement())

  propertyId     String
  propertyRuleId Int

  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rule     PropertyRules @relation(fields: [propertyRuleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, propertyRuleId])
  @@map("property_rule_value")
}

// ==============================
// REPORT TYPE
// ==============================
model ReportType {
  id     Int    @id @default(autoincrement())
  code   String @unique
  nameEn String @unique @map("name_en")
  nameKh String @unique @map("name_kh")
  icon   String

  reports PropertyReport[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("report_types")
}

// ==============================
// PROPERTY REPORT
// ==============================
model PropertyReport {
  id           Int    @id @default(autoincrement())
  propertyId   String @map("property_id")
  userId       String @map("user_id")
  reportTypeId Int    @map("report_type_id")
  description  String

  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportType ReportType @relation(fields: [reportTypeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([propertyId, userId])
  @@map("property_reports")
}

// ==============================
// PROPERTY IMAGE
// ==============================
model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  imageKey   String   @map("image_key")
  isCover    Boolean  @default(false) @map("is_cover")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@map("property_images")
}

// ==============================
// AMENITIES
// ==============================
model Amenity {
  id     Int    @id @default(autoincrement())
  code   String @unique
  nameEn String @unique @map("name_en")
  nameKh String @unique @map("name_kh")
  icon   String

  properties PropertyAmenity[]

  createdAt DateTime @default(now())

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String @map("property_id")
  amenityId  Int    @map("amenity_id")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

// ==============================
// FAVORITES
// ==============================
model Favorite {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  propertyId String @map("property_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, propertyId])
  @@map("favourites")
}

// ==============================
// FEEDBACK
// ==============================
model Feedback {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  type        FeedbackType
  description String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("feedbacks")
}

// ==============================
// AUDIT LOG
// ==============================
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  route        String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  statusCode   Int      @map("status_code")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([resourceType])
  @@index([action])
  @@map("audit_logs")
}

// ==============================
// APP SETTINGS
// ==============================
model AppSettings {
  id                       Int      @id @default(1)
  maintenanceMode          Boolean  @default(false) @map("maintenance_mode")
  registrationEnabled      Boolean  @default(true) @map("registration_enabled")
  maxPropertiesPerLandlord Int      @default(3) @map("max_properties_per_landlord")
  maxImagesPerProperty     Int      @default(10) @map("max_images_per_property")
  minPropertyPrice         Decimal? @map("min_property_price")
  maxPropertyPrice         Decimal? @map("max_property_price")
  commissionRate           Decimal  @default(0) @map("commission_rate")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ==============================
// LEGAL DOCUMENTS
// ==============================
enum LegalDocumentSlug {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
}

model LegalDocument {
  id        Int               @id @default(autoincrement())
  slug      LegalDocumentSlug @unique
  contentEn String            @map("content_en")
  contentKh String            @map("content_kh")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("legal_documents")
}
